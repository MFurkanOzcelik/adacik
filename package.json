{
  "name": "adacik",
  "productName": "Adacık",
  "version": "1.1.0",
  "description": "Windows için yüzen, Dynamic Island tarzı akıllı çentik",
  "author": "MFurkanOzcelik",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "homepage": "https://github.com/MFurkanOzcelik/adacik",
  "repository": {
    "type": "git",
    "url": "https://github.com/MFurkanOzcelik/adacik.git"
  },
  "build": {
    "appId": "com.adacik.app",
    "productName": "Adacık",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "*.ps1",
      "vendor/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "*.ps1"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Adacik-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adacık",
      "runAfterFinish": true,
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055"
    },
    "portable": {
      "artifactName": "Adacik-${version}-portable.${ext}"
    },
    "executableName": "Adacik"
  }
}